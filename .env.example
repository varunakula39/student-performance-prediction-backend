# =====================================================================
# Student Performance Prediction Backend - Environment Template
# =====================================================================

# Server Port (Default: 8080)
SERVER_PORT=8080

# MySQL Database Configuration
# In production, replace with your cloud MySQL instance (e.g. AWS RDS, Railway, PlanetScale, Aiven)
DB_URL=jdbc:mysql://localhost:3306/student_performance_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Python FastAPI Machine Learning Service URL
# Local default: http://localhost:8001/predict
# Cloud default (e.g. Render / Railway): https://your-ml-service.onrender.com/predict
ML_SERVICE_URL=http://localhost:8001/predict

# JWT Authentication (HS256 256-bit secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
# In production, include your Vercel frontend URL:
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://student-performance-prediction-frontend.vercel.app
CORS_ALLOWED_PATTERNS=https://*.vercel.app,http://localhost:[*],http://127.0.0.1:[*]
